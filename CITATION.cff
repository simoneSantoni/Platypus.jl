version: 0.2.0
repository-code: "https://github.com/simoneSantoni/Platypus.jl"
url: "https://simoneSantoni.github.io/Platypus.jl/dev/"
license: MIT
keywords:
  - atypicality
  - computational social science
  - density estimation
  - Julia
